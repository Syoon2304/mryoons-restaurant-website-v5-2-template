{
  "policy_version": "2.0.0",
  "package_filename": "website.zip",
  "max_compressed_bytes": 20971520,
  "max_expanded_bytes": 104857600,
  "max_single_file_bytes": 20971520,
  "max_file_count": 2000,
  "max_compression_ratio": 100,
  "allowed_extensions": [
    ".html",
    ".htm",
    ".css",
    ".js",
    ".mjs",
    ".json",
    ".xml",
    ".txt",
    ".webmanifest",
    ".svg",
    ".png",
    ".jpg",
    ".jpeg",
    ".webp",
    ".avif",
    ".gif",
    ".ico",
    ".woff",
    ".woff2",
    ".ttf",
    ".otf",
    ".pdf",
    ".ics"
  ],
  "allowed_extensionless": [
    "_headers",
    "_redirects"
  ],
  "required_root_files": [
    "index.html",
    "site-manifest.json",
    "version.json",
    "robots.txt",
    "sitemap.xml",
    "404.html",
    "_headers",
    "_redirects"
  ],
  "disallowed_directories": [
    ".git",
    ".github",
    "functions",
    "scripts",
    "infrastructure",
    "handoff",
    "tests",
    "templates",
    "node_modules",
    "vendor",
    "private",
    "originals",
    "source",
    "sources",
    "workbooks",
    "__MACOSX"
  ],
  "forbidden_exact_names": [
    ".DS_Store",
    ".env",
    "00 EXISTING WEBSITE IMPORT APPROVAL.md",
    "AGENTS.md",
    "BUSINESS FOLDER VERSION.md",
    "COURSE PACKAGE MANIFEST.sha256",
    "EXISTING WEBSITE IMPORT REGISTER.md",
    "PACKAGE MANIFEST.sha256",
    "README - OWNER APPROVAL REQUIRED.md",
    "README - PUBLIC WEBSITE OUTPUT ONLY.md",
    "STRUCTURED BUSINESS DATA.json",
    "WEBSITE SOURCE OF TRUTH.md"
  ],
  "forbidden_name_parts": [
    "ai asset register",
    "business record",
    "chatgpt project instructions",
    "course files are read only",
    "customer record",
    "design lock",
    "employee record",
    "existing website import",
    "inspiration - private",
    "interview notes",
    "invoice",
    "launch record",
    "license scan",
    "maintenance log",
    "owner notes",
    "passport",
    "permit scan",
    "photo original",
    "photos - originals",
    "readiness report",
    "restaurant website starter pack",
    "review tracker",
    "source of truth",
    "structured business data",
    "tax document",
    "videos - originals",
    "website assets",
    "website program files",
    "workbook"
  ],
  "forbidden_suffixes": [
    ".doc",
    ".docx",
    ".key",
    ".keynote",
    ".numbers",
    ".p12",
    ".pages",
    ".pem",
    ".pfx",
    ".ppt",
    ".pptx",
    ".sqlite",
    ".sqlite3",
    ".xls",
    ".xlsx"
  ],
  "forbidden_capture_endings": [
    ".har",
    ".maff",
    ".mht",
    ".mhtml",
    ".pcap",
    ".pcapng",
    ".saz",
    ".warc",
    ".warc.gz",
    ".wacz",
    ".webarchive",
    ".webbundle",
    ".wbn"
  ],
  "max_bytes_by_extension": {
    ".pdf": 10485760,
    ".gif": 5242880,
    ".png": 8388608,
    ".jpg": 8388608,
    ".jpeg": 8388608,
    ".webp": 8388608,
    ".avif": 8388608,
    ".woff": 3145728,
    ".woff2": 3145728,
    ".ttf": 3145728,
    ".otf": 3145728
  }
}
