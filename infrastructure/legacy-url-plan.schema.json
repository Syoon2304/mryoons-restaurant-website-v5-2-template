{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://course.invalid/schemas/legacy-url-plan-v1.json",
  "title": "Owner-approved old website URL replacement plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "source_origin", "reviewed_at", "owner_approval_reference", "routes"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "status": {"type": "string", "enum": ["not-populated", "in-progress", "owner-approved"]},
    "source_origin": {"type": ["string", "null"], "format": "https-origin", "maxLength": 255},
    "reviewed_at": {"type": ["string", "null"], "format": "date-time", "maxLength": 40},
    "owner_approval_reference": {"type": ["string", "null"], "maxLength": 128},
    "routes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_url_path", "observed_title", "page_purpose", "key_topics", "replacement_handling", "destination_url_path", "owner_approved", "build_status"],
        "properties": {
          "source_url_path": {"type": "string", "format": "site-url-path", "maxLength": 255},
          "observed_title": {"type": ["string", "null"], "maxLength": 160},
          "page_purpose": {"type": "string", "minLength": 1, "maxLength": 240},
          "key_topics": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 100}},
          "replacement_handling": {"type": "string", "enum": ["rebuild-same-url", "permanent-redirect"]},
          "destination_url_path": {"type": "string", "format": "site-url-path", "maxLength": 255},
          "owner_approved": {"type": "boolean"},
          "build_status": {"type": "string", "enum": ["planned", "built", "verified"]}
        }
      }
    }
  }
}
